# DVC ignore file — patterns here are excluded from DVC tracking

# Python cache
__pycache__
*.pyc
*.pyo
.pytest_cache

# W&B run logs (large, not reproducible artifacts)
wandb/

# Annotation exports (regenerated by LLM annotator)
data/annotations_export.json

# Label Studio tasks (regenerated by run_phase08.py)
data/label_studio_tasks.json

# Eval HTML reports (regenerated by evaluator)
data/eval_report_*.html
